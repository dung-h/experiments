+"""Run a deterministic, offline Qonductor scheduler smoke test.
+
+The full paper sweep uses many jobs and a process pool.  This small check
+exercises transpilation, fidelity estimation, runtime estimation, and the
+multi-objective assignment path on two current Qiskit Runtime fake backends.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+
+from src.scheduler.multi_objective_scheduler import (
+    MultiObjectiveScheduler,
+    ProblemType,
+    TranspilationLevel,
+)
+from src.utils.benchmark import (
+    generate_random_job,
+    get_benchmark_names,
+    get_fake_backends,
+)
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main() -> None:
+    # Avoid nested process pools in a one-job check.  Larger runs can leave
+    # this unset to use the original parallel implementation.
+    os.environ.setdefault("QONDUCTOR_TRANSPILE_PROCESSES", "1")
+    os.environ.setdefault("QISKIT_NUM_PROCS", "1")
+
+    backends = sorted(
+        get_fake_backends(remove_retired=True), key=lambda backend: backend.num_qubits
+    )[:2]
+    generator = np.random.default_rng(7)
+    job = generate_random_job(
+        5,
+        get_benchmark_names(),
+        generator,
+        circuit_count=2,
+        shots=4000,
+    )
+    scheduler = MultiObjectiveScheduler(
+        transpilation_count=1,
+        transpilation_level=TranspilationLevel.PROCESSOR_TYPE,
+        problem_type=ProblemType.DISCRETE,
+    )
+    assignments, rejected, metadata = scheduler.schedule([job], backends)
+
+    result = {
+        "backends": [backend.name for backend in backends],
+        "backend_qubits": [backend.num_qubits for backend in backends],
+        "circuits": len(job.circuits),
+        "circuit_widths": [circuit.num_qubits for circuit in job.circuits],
+        "shots": job.shots,
+        "assignments": len(assignments),
+        "rejected": len(rejected),
+        "solution_execution_times": metadata["solution_execution_times"],
+        "transpilation_time_seconds": metadata["transpilation_time"],
+        "estimation_time_seconds": metadata["estimation_time"],
+        "optimization_time_seconds": metadata["optimization_time"],
+    }
+    output = ROOT / "results" / "fake_scheduler_smoke.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
