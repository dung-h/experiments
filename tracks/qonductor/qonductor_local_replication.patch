+"""Recompute Qonductor's public-data headline metrics.
+
+This script intentionally uses only the CSV artifacts checked into the
+repository.  It does not contact IBM Quantum and therefore does not require
+an API token.  The values are reported in the units used by the original
+plots: execution-time estimation errors are milliseconds, while the
+fidelity/runtime Pareto and end-to-end JCT tables use seconds.
+
+Usage::
+
+    PYTHONPATH=. python experiments/reproduce_public_results.py
+    PYTHONPATH=. python experiments/reproduce_public_results.py --output results/qonductor_metrics.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def pair_metrics(frame: pd.DataFrame, prediction: str, target: str) -> dict[str, float]:
+    """Return the same error views used in the estimator analysis."""
+    predicted = frame[prediction].to_numpy(dtype=float)
+    observed = frame[target].to_numpy(dtype=float)
+    nonzero = observed != 0
+    return {
+        "n": int(len(frame)),
+        "mae": float(mean_absolute_error(observed, predicted)),
+        "rmse": float(np.sqrt(mean_squared_error(observed, predicted))),
+        "r2": float(r2_score(observed, predicted)),
+        "mape_percent": float(
+            np.mean(np.abs((predicted[nonzero] - observed[nonzero]) / observed[nonzero]))
+            * 100
+        ),
+        "bias_prediction_minus_target": float(np.mean(predicted - observed)),
+    }
+
+
+def load_csv(relative_path: str, required_columns: set[str]) -> pd.DataFrame:
+    path = ROOT / relative_path
+    frame = pd.read_csv(path)
+    missing = required_columns.difference(frame.columns)
+    if missing:
+        raise ValueError(f"{path} is missing columns: {sorted(missing)}")
+    return frame
+
+
+def compute_metrics() -> dict[str, object]:
+    execution = load_csv(
+        "data/resource_estimator/execution_time_estimations.csv",
+        {"predicted", "real", "dag"},
+    )
+    fidelity = load_csv(
+        "data/resource_estimator/fidelity_estimations.csv",
+        {"predicted", "real", "model"},
+    )
+    pareto = load_csv(
+        "data/resource_estimator/fidelity_runtime.csv", {"fidelity", "runtime"}
+    )
+    qonductor = load_csv("data/end_to_end/jct_fidelity_1500.csv", {"fidelity", "JCT"})
+    fcfs = load_csv("data/end_to_end/jct_fidelity_fcfs.csv", {"fidelity", "JCT"})
+    utilization = load_csv(
+        "data/end_to_end/utilizations.csv", {"Qonductor", "FCFS"}
+    )
+
+    jct_reduction = (fcfs["JCT"].mean() - qonductor["JCT"].mean()) / fcfs["JCT"].mean()
+    fidelity_loss = (fcfs["fidelity"].mean() - qonductor["fidelity"].mean()) / fcfs[
+        "fidelity"
+    ].mean()
+    utilization_gain = (utilization["Qonductor"].mean() - utilization["FCFS"].mean()) / utilization[
+        "FCFS"
+    ].mean()
+
+    # The estimator plot marks nondominated points in (runtime, 1-fidelity).
+    costs = pareto[["runtime"]].to_numpy()
+    costs = np.column_stack((costs, 1 - pareto["fidelity"].to_numpy()))
+    is_efficient = np.ones(len(costs), dtype=bool)
+    for i, cost in enumerate(costs):
+        if is_efficient[i]:
+            is_efficient[is_efficient] = np.any(costs[is_efficient] < cost, axis=1)
+            is_efficient[i] = True
+
+    return {
+        "artifacts": {
+            "execution_time_estimations": int(len(execution)),
+            "fidelity_estimations": int(len(fidelity)),
+            "fidelity_runtime": int(len(pareto)),
+            "end_to_end_qonductor": int(len(qonductor)),
+            "end_to_end_fcfs": int(len(fcfs)),
+            "end_to_end_utilization": int(len(utilization)),
+        },
+        "target_semantics": {
+            "execution_estimator": "archived IBM execution-time target; repository plot labels error in ms",
+            "fidelity_estimator": "archived IBM circuit/job fidelity proxy; unitless",
+            "pareto_runtime": "resource-estimator runtime axis in seconds",
+            "end_to_end_JCT": "workflow/job completion time in seconds",
+            "utilization": "QPU utilization percentage points",
+        },
+        "execution_time": {
+            "qonductor_vs_real": pair_metrics(execution, "predicted", "real"),
+            "dag_vs_real": pair_metrics(execution, "dag", "real"),
+        },
+        "fidelity": {
+            "qonductor_vs_real": pair_metrics(fidelity, "predicted", "real"),
+            "numerical_model_vs_real": pair_metrics(fidelity, "model", "real"),
+        },
+        "pareto": {
+            "nondominated_points": int(is_efficient.sum()),
+            "runtime_mean_seconds": float(pareto["runtime"].mean()),
+            "fidelity_mean": float(pareto["fidelity"].mean()),
+        },
+        "end_to_end": {
+            "qonductor_mean_JCT_seconds": float(qonductor["JCT"].mean()),
+            "fcfs_mean_JCT_seconds": float(fcfs["JCT"].mean()),
+            "mean_JCT_reduction_percent": float(jct_reduction * 100),
+            "qonductor_mean_fidelity": float(qonductor["fidelity"].mean()),
+            "fcfs_mean_fidelity": float(fcfs["fidelity"].mean()),
+            "relative_fidelity_loss_percent": float(fidelity_loss * 100),
+            "qonductor_mean_utilization_percent": float(utilization["Qonductor"].mean()),
+            "fcfs_mean_utilization_percent": float(utilization["FCFS"].mean()),
+            "utilization_gain_percentage_points": float(
+                utilization["Qonductor"].mean() - utilization["FCFS"].mean()
+            ),
+            "relative_utilization_gain_percent": float(utilization_gain * 100),
+        },
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=ROOT / "results" / "reproduction_metrics.json",
+    )
+    args = parser.parse_args()
+    metrics = compute_metrics()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(metrics, indent=2) + "\n")
+    print(json.dumps(metrics, indent=2))
+
+
+if __name__ == "__main__":
+    main()
